# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node / frontend
node_modules/
dist/
.vite/

# Local environment (paths/ports are machine-specific; commit .env.example only)
.env

# Copyrighted questionnaire item text (public repo): verbatim wording for
# bfi2s / rosas_* / erq lives here and must NEVER be committed. Only the
# tracked configs/questionnaires/*.yaml (structure/IDs/scoring) are public.
/configs/questionnaires/local/

# Copyrighted questionnaire SOURCE documents (uploaded locally for verbatim
# extraction into the local/ files above). Binary instrument sources only; the
# tracked docs/*.md specs stay committed.
/docs/*.docx
/docs/*.pdf
/docs/*.doc

# Local data (never commit raw research data or the DB)
/data/bst.db
/data/bst.db-journal
/data/bst.db-wal
/data/bst.db-shm
/data/recordings/*
# Archival copies made by the console's Save / Save As (participant A/V).
/data/saved_recordings/*
/data/exports/*
/data/logs/*
/data/sessions/*
/data/backups/*
!**/.gitkeep

# OS
.DS_Store
