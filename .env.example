# BST Data Collection Platform - environment configuration
# Copy to .env and adjust for the host. All paths/ports come from here;
# nothing in app code hardcodes localhost or absolute paths.

# --- Network ---
API_HOST=0.0.0.0
API_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
PLATFORM_VERSION=0.1.0

# --- Storage ---
# Defaults below are repo-relative for development (days 1-4).
# On the lab server, point RECORDINGS_DIR at the mounted external SSD,
# e.g. RECORDINGS_DIR=/data/bst/recordings (see product_plan.md storage resolution).
DATA_DIR=./data
DB_PATH=./data/bst.db
RECORDINGS_DIR=./data/recordings
EXPORTS_DIR=./data/exports
LOGS_DIR=./data/logs
SESSIONS_DIR=./data/sessions
BACKUPS_DIR=./data/backups
CONFIGS_DIR=./configs

# Timestamped DB backups (startup + session completion); keep the last N copies.
DB_BACKUP_KEEP=20

# --- Perception orchestrator (read-only consumer; see perception_integration.md) ---
# READ-ONLY: the adapter only GETs /state/* and /health; it never mutates the
# orchestrator. OFF by default so dev/CI never poll; the lab server sets
# PERCEPTION_ENABLED=true.
PERCEPTION_ENABLED=false
PERCEPTION_BASE_URL=http://localhost:8000
PERCEPTION_POLL_MS_ASR=500
PERCEPTION_POLL_MS_EMOTION=200
PERCEPTION_POLL_MS_GESTURE=500
PERCEPTION_HEALTH_MS=5000
PERCEPTION_HTTP_TIMEOUT_MS=2000
# Per-task enable flags (log only the streams a given study needs).
PERCEPTION_ASR_ENABLED=true
PERCEPTION_EMOTION_ENABLED=true
PERCEPTION_GESTURE_ENABLED=true
# Mirror every reading onto the session timeline? Off by default (perception is
# high-frequency; the timeline carries only outage/recovery transitions).
PERCEPTION_TIMELINE_EVERY_READING=false

# --- A/V recording (P0.8) ---
# OFF by default so dev/CI never spawn ffmpeg. The lab server sets
# RECORDING_ENABLED=true. Defaults below ARE the Day-1 verified Brio/NVENC
# command; override any of them in .env (e.g. point RECORDINGS_DIR at the SSD).
RECORDING_ENABLED=false
RECORDING_FFMPEG_BIN=ffmpeg
RECORDING_VIDEO_DEVICE=/dev/video0
RECORDING_VIDEO_INPUT_FORMAT=v4l2
RECORDING_VIDEO_INPUT_PIXEL=mjpeg
RECORDING_VIDEO_SIZE=1920x1080
RECORDING_FRAMERATE=30
RECORDING_AUDIO_DEVICE=hw:CARD=BRIO,DEV=0
RECORDING_AUDIO_INPUT_FORMAT=alsa
RECORDING_THREAD_QUEUE_SIZE=1024
RECORDING_VIDEO_CODEC=h264_nvenc
RECORDING_VIDEO_BITRATE=5M
RECORDING_PIX_FMT=yuv420p
RECORDING_AUDIO_CODEC=aac
RECORDING_AUDIO_BITRATE=128k
RECORDING_CONTAINER=mp4
# ffmpeg 4.4 -> passthrough; ffmpeg 5.x renamed this to -fps_mode.
RECORDING_VSYNC=passthrough
RECORDING_START_SETTLE_S=0.4
RECORDING_STOP_TIMEOUT_S=10.0
# dev/CI only: synthetic lavfi A/V instead of the camera (no hardware/GPU).
RECORDING_USE_TEST_SOURCE=false
